{
  "name": "@local/dsh-job-notify",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "Windows 原生通知：后台任务结算或一轮对话结束时提醒（DeepSeek Harness 插件）",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imnotRiv3r/dsh-job-notify.git"
  },
  "homepage": "https://github.com/imnotRiv3r/dsh-job-notify#readme",
  "bugs": {
    "url": "https://github.com/imnotRiv3r/dsh-job-notify/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "windows",
    "toast",
    "notification",
    "background-jobs"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "toast.ps1",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "check": "node --check index.js && node --check client.js && node --check lib/format.js && node --check lib/toast.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "compatibility": {
      "dsh": ">=0.2.0-rc.1 <0.3.0-0"
    }
  }
}
